{
  "schemaVersion": 1,
  "id": "litematicainventories",
  "version": "${version}",
  "name": "Litematica Storages+",
  "description": "Portable schematic inventories, container preview and permanent tracked resource storages for Litematica.",
  "authors": [
    "asaul"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.asaul.litematicainventories.LitematicaInventoriesClient"
    ],
    "modmenu": [
      "dev.asaul.litematicainventories.ModMenuIntegration"
    ]
  },
  "mixins": [
    "litematicainventories.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "${game_range}",
    "java": ">=25",
    "fabric-api": "${fabric_range}",
    "litematica": "${litematica_range}",
    "malilib": "${malilib_range}"
  },
  "suggests": {
    "modmenu": "*"
  },
  "icon": "assets/litematicainventories/icon.png"
}
